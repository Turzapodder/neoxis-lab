# Copy to .env.local (or .env) and fill in real values. Never commit real secrets.
# .env.local is git-ignored by the Next.js convention in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string for the CMS store. When unreachable, the app
# transparently falls back to the JSON file at data/cms.json.
MONGO_URL=
# Optional database name (defaults to "neoxis").
MONGODB_DB=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auth ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Initial admin credentials (seeded on first run).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI copilot ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
